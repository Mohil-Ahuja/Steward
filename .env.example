# Steward configuration.
#
# Copy to .env for local development:   cp .env.example .env
# Every variable below is read by steward/config.py. Names are unprefixed.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./steward.db
# Production: DATABASE_URL=postgresql+asyncpg://steward:CHANGE_ME@postgres:5432/steward

ENVIRONMENT=development
# development | staging | production
# In production Steward refuses to start an unauthenticated control plane and
# refuses to accept unsigned agent tokens. Both are deliberate: the failure
# should be loud at deploy time, not silent at request time.

# ---------------------------------------------------------------------------
# Data plane: the JWT an agent presents to call tools
# ---------------------------------------------------------------------------
# Leave JWT_JWKS_URL empty in development to accept unsigned tokens, so the
# demo runs without standing up an identity provider. This is refused outright
# when ENVIRONMENT=production.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
JWT_ALGORITHMS=RS256
JWT_LEEWAY_SECONDS=30

# ---------------------------------------------------------------------------
# Control plane: who may write policy
# ---------------------------------------------------------------------------
# Comma-separated key:role pairs. Roles, least to most authority:
#   auditor - read policies, tools, audit log, run /v1/check
#   author  - write policies, run discovery, decide approvals
#   admin   - pin/quarantine tools, roll policies back
#
# ADMIN_API_KEYS=sk-steward-admin-CHANGE_ME:admin,sk-steward-ci-CHANGE_ME:author
ADMIN_API_KEYS=

# Local development only. With no keys configured and this false, the control
# plane is locked rather than open -- an unauthenticated policy API is a way to
# grant yourself '*:*'.
ALLOW_UNAUTHENTICATED_CONTROL_PLANE=true

# ---------------------------------------------------------------------------
# Audit
# ---------------------------------------------------------------------------
# HMAC key for the tamper-evident chain. When unset, an ephemeral key is
# generated per process: enough to catch accidental corruption, useless across
# a restart. Set it from a secret manager in production, and store it somewhere
# other than the database it protects -- an attacker who can rewrite the log
# and also read the key can forge a valid chain.
AUDIT_CHAIN_KEY=

AUDIT_ARGUMENT_REDACTION_KEYS=password,token,secret,authorization,api_key,apikey,private_key,access_token,refresh_token,client_secret,ssn,card_number
AUDIT_REDACT_VALUE_PATTERNS=true

# ---------------------------------------------------------------------------
# Policy engine
# ---------------------------------------------------------------------------
# Refuse tools absent from the catalogue. This is what makes a newly appeared
# upstream tool unreachable by default rather than reachable by default.
REQUIRE_KNOWN_TOOL=true

# Refuse pinned tools whose definition has drifted (rug-pull defence).
ENFORCE_TOOL_INTEGRITY=true

# The MCP spec says clients MUST treat tool annotations as untrusted unless the
# server is trusted. Leave false: with it false an annotation can only raise a
# tool's risk tier, never lower it, so a hostile server cannot label
# `delete_everything` as readOnlyHint and be believed.
TRUST_TOOL_ANNOTATIONS=false

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------
GATEWAY_SERVER_NAME=steward-gateway
GATEWAY_PROTOCOL_VERSION=2026-07-28
UPSTREAM_REGISTRY_PATH=config/upstreams.yaml
UPSTREAM_TIMEOUT_SECONDS=30
TOOL_NAMESPACE_SEPARATOR=__

APPROVAL_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Model access (only needed for `steward eval --live`)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
JUDGE_MODEL=claude-opus-5
AGENT_MAX_TOKENS=8000
AGENT_MAX_STEPS=12
